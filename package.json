{
  "name": "betterverses",
  "version": "0.1.0",
  "private": true,
  "description": "BetterVerses.com — the right Bible verse for right now. Zero-dependency static site generator.",
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "node build.js",
    "preview": "node build.js && node scripts/preview.js",
