    "bible:build": "node scripts/build-bible.js",
    "newsletter": "node scripts/newsletter.js",
    "printables": "node scripts/printables.js && python3 scripts/render-pdfs.py",
    "bible:build": "node scripts/build-bible.js",
    "newsletter": "node scripts/newsletter.js",
    "printables": "node scripts/printables.js && python3 scripts/render-pdfs.py",
    "check": "node build.js --check"
  },
  "devDependencies": {
    "world-english-bible": "^1.0.1"
  }
}
